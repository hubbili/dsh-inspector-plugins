{
  "name": "dsh-plugin-llm-wire-debug",
  "version": "0.1.0",
  "description": "Local unredacted model request, cURL, SSE and prompt translation inspector for DeepSeek Harness",
  "keywords": ["dsh-plugin", "deepseek-harness", "debugging", "sse"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/hubbili/dsh-inspector-plugins.git", "directory": "packages/llm-wire-debug" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/llm-wire-debug.d.ts",
  "exports": {
    ".": { "types": "./lib/types/llm-wire-debug.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-session"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.2", "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2", "react": "^18.2.0" },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5", "ws": "^8.21.0" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" }
}
